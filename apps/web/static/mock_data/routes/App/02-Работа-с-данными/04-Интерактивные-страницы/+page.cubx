>

{#if data?.spec }
<AlluvialChart
    data={data?.spec?.map((el, ii) => {
        return data?.default?.map(ee => {
            if (ee['element_' + (ii + 1)] !== '+') {
                return null;
            }
            return {
                "source": el,
                "target": ee.group,
                "value":1,
            }
        }).filter(e => e !== null)
    }).flat()}
    options={{
	"alluvial": {
		"nodes": [
            ...(data?.spec?.map((el, ii) => {
                return [{name: el, "category": 'соответствие', depth:1}]
            }).flat() || []),
            ...data?.default.map((ee, cc) => {
                    return {
                        "name":  ee.group,
                        "category":'соответствие',
                        "depth": 1,
                    }
                })
			
		]
	},
	"height": "600px",
    "width": "100%",
	"color": {
		"scale": {
